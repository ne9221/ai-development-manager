{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "task_id", "project_id", "created_at", "from_provider", "to_provider", "from_session", "reason", "completed_work", "current_state", "files_changed", "commits", "tests", "known_issues", "do_not_touch", "next_action", "acceptance_criteria", "minimal_context", "feature_branch", "push_status", "worktree_path", "remote_sha", "tests_status"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "from_provider": {"type": ["string", "null"]},
    "to_provider": {"type": ["string", "null"]},
    "from_session": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "completed_work": {"type": "array", "items": {"type": "string"}},
    "current_state": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "commits": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "exit_code", "output_summary", "started_at", "completed_at"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": ["integer", "null"]},
          "output_summary": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "timed_out": {"type": "boolean"}
        }
      }
    },
    "known_issues": {"type": "array", "items": {"type": "string"}},
    "do_not_touch": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "minimal_context": {"type": "string", "maxLength": 4000},
    "completion_report": {"type": "object"},
    "feature_branch": {"type": ["string", "null"], "description": "Repo-write terminal evidence: the actual pushed feature branch, verified against the remote; null when no such evidence exists."},
    "push_status": {"type": ["string", "null"], "description": "\"verified\" only when an independent remote readback proved the branch was pushed and matched the local final commit exactly; null when no such evidence exists."},
    "worktree_path": {"type": ["string", "null"], "description": "The isolated worktree path the repo-write execution actually ran in; null when no such evidence exists."},
    "remote_sha": {"type": ["string", "null"], "description": "The remote branch's SHA at readback time, proven equal to the local final commit SHA; null when no such evidence exists."},
    "tests_status": {"type": ["string", "null"], "enum": ["passed", "failed", "not_required", null], "description": "\"passed\"/\"failed\" from ADM independently running the Task's own declared validation_command in the isolated worktree and reading its real exit code -- never a provider's self-report; \"not_required\" when the Task declared no validation_command; null when no repo-write evidence exists at all."}
  }
}
