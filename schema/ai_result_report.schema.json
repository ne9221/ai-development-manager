{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADM AI result report (agent-emitted claim)",
  "description": "What an agent emits at the end of a turn, inside a ```adm-result fenced block or as native structured output. Every value is a claim; ADM normalizes it into schema/ai_result.schema.json and verifies what it can. Generated from manager/nextplan/result.py FIELD_KINDS.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "adm-ai-result/1"
    },
    "task_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "session_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "agent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "mode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "PASS",
            "FAIL",
            "PARTIAL",
            "BLOCKED",
            "IN_PROGRESS",
            "ERROR"
          ]
        }
      ]
    },
    "progress_percent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      ]
    },
    "repo": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "worktree": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "branch": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "base_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "head_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "files_changed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "files_created": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "files_deleted": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "tests_run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "tests_passed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "tests_failed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "tests_skipped": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "commit_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "commits": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        }
      ]
    },
    "push_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "pushed",
            "not_pushed",
            "failed",
            "not_applicable"
          ]
        }
      ]
    },
    "remote_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "git_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "clean",
            "dirty"
          ]
        }
      ]
    },
    "dirty_paths": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "review_required": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "review_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "not_requested",
            "pending",
            "pass",
            "fail",
            "not_applicable"
          ]
        }
      ]
    },
    "review_verdict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      ]
    },
    "reviewed_sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "terminal_state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "terminal",
            "non_terminal"
          ]
        }
      ]
    },
    "recommended_next_action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "ssot_sync_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "synced",
                    "failed",
                    "not_required"
                  ]
                }
              ]
            },
            "drive": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "synced",
                    "failed",
                    "not_required"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
