{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Execution",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "reserved"}}, "required": ["status"]},
      "then": {
        "required": ["reserved_at", "quota_evidence", "finished_at", "session_id", "provider_session_id"],
        "properties": {
          "reserved_at": {"type": "string", "format": "date-time"},
          "started_at": {"type": "null"},
          "completed_at": {"type": "null"},
          "finished_at": {"type": "null"},
          "session_id": {"type": "null"},
          "provider_session_id": {"type": "null"},
          "elapsed_minutes": {"type": "null"},
          "quota_evidence": {"type": "object", "minProperties": 1},
          "quota_before": {"type": "null"},
          "quota_after": {"type": "null"},
          "quota_delta": {"type": "null"},
          "source_confidence": {"type": "null"},
          "access": {"type": "null"},
          "lease_evidence": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]},
      "then": {
        "required": ["reserved_at", "quota_evidence", "finished_at", "session_id", "provider_session_id", "access", "lease_evidence"],
        "properties": {
          "reserved_at": {"type": "string", "format": "date-time"},
          "started_at": {"type": "null"}, "completed_at": {"type": "null"},
          "finished_at": {"type": "string", "format": "date-time"},
          "session_id": {"type": "null"}, "provider_session_id": {"type": "null"},
          "elapsed_minutes": {"const": 0}, "quota_evidence": {"type": "object", "minProperties": 1},
          "quota_before": {"type": "null"}, "quota_after": {"type": "null"}, "quota_delta": {"type": "null"},
          "source_confidence": {"type": "null"}, "access": {"type": "null"}, "lease_evidence": {"type": "null"},
          "cleanup_evidence": {"type": ["null"]}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["running", "completed", "failed", "interrupted"]}}, "required": ["status"]},
      "then": {"properties": {"started_at": {"type": "string", "format": "date-time"}, "quota_before": {"type": "object"}, "source_confidence": {"type": "string"}}}
    },
    {
      "if": {"properties": {"access": {"const": "production_write"}}, "required": ["access"]},
      "then": {"required": ["lease_evidence"], "properties": {"lease_evidence": {"type": "object", "properties": {"authority": {"const": "acquired"}}}}}
    },
    {
      "if": {"properties": {"access": {"const": "read_only"}}, "required": ["access"]},
      "then": {"required": ["lease_evidence"], "properties": {"lease_evidence": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"reserved_at": {"type": "string"}, "status": {"const": "running"}},
        "required": ["reserved_at", "status"]
      },
      "then": {"required": ["access", "lease_evidence"], "properties": {"access": {"enum": ["production_write", "read_only"]}}}
    }
  ],
  "required": ["execution_id", "task_id", "project_id", "provider", "mode", "effort", "started_at", "completed_at", "elapsed_minutes", "status", "quota_before", "quota_after", "quota_delta", "source_confidence", "notes", "task_snapshot"],
  "properties": {
    "execution_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "mode": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "reserved_at": {"type": ["string", "null"], "format": "date-time", "description": "Reservation timestamp; absent on legacy records."},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time", "description": "Explicit execution finish timestamp; legacy records may use completed_at only."},
    "session_id": {"type": ["string", "null"], "minLength": 1, "description": "Primary manager canonical session identity."},
    "provider_session_id": {"type": ["string", "null"], "minLength": 1, "description": "Raw provider session ID for the primary linked session."},
    "elapsed_minutes": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["reserved", "running", "completed", "failed", "interrupted", "cancelled"]},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "retry_of_execution_id": {"type": ["string", "null"], "minLength": 1},
    "heartbeat_at": {"type": ["string", "null"], "format": "date-time", "description": "Orchestrator liveness timestamp; provider wait ticks may refresh it."},
    "progress_updated_at": {"type": ["string", "null"], "format": "date-time", "description": "Authoritative meaningful lifecycle/provider progress timestamp."},
    "hard_timeout_at": {"type": ["string", "null"], "format": "date-time"},
    "last_provider_event": {"type": ["string", "null"], "maxLength": 100},
    "provider_evidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["host", "pid", "started_at"],
          "properties": {
            "host": {"type": "string", "minLength": 1, "maxLength": 100},
            "pid": {"type": "integer", "minimum": 1},
            "creation_identity": {"type": "string", "minLength": 1, "maxLength": 200},
            "started_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "stale_at": {"type": ["string", "null"], "format": "date-time"},
    "recovery_reason": {"type": ["string", "null"], "maxLength": 300},
    "terminal_reason": {"type": ["string", "null"], "maxLength": 300},
    "quota_evidence": {"type": ["object", "null"], "description": "Caller-supplied quota decision evidence preserved by reservation."},
    "quota_before": {"type": ["object", "null"]},
    "quota_after": {"type": ["object", "null"]},
    "quota_delta": {"type": ["object", "null"]},
    "source_confidence": {"type": ["string", "null"]},
    "access": {"enum": ["production_write", "read_only", null]},
    "lease_evidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["authority", "lock_id", "generation", "repository", "branch", "scope", "baseline_head"],
          "properties": {
            "authority": {"const": "acquired"},
            "lock_id": {"type": "string", "pattern": "^repo-[0-9a-f]{64}$"},
            "generation": {"type": "integer", "minimum": 1},
            "repository": {"type": "string", "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$"},
            "branch": {"type": "string", "pattern": "^refs/heads/.+$"},
            "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "baseline_head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
          }
        }
      ]
    },
    "cleanup_evidence": {
      "type": ["object", "null"],
      "description": "Bounded terminal cleanup audit; never contains a lease token."
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "task_snapshot": {"type": "object"}
  }
}
