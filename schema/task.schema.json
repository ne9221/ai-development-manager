{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "project_id", "title", "status", "priority", "created_at", "updated_at", "task_type", "expected_minutes", "scope", "constraints", "acceptance_criteria", "recommended_provider", "assigned_provider", "mode", "effort", "depends_on", "blocked_reason", "source_context", "current_progress", "next_action"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "ready", "in_progress", "blocked", "completed", "cancelled"]},
    "priority": {"enum": ["low", "normal", "high", "urgent"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "task_type": {"type": "string", "minLength": 1},
    "complexity": {"enum": ["low", "medium", "high"]},
    "expected_minutes": {"type": "number", "exclusiveMinimum": 0},
    "needs_repo_edit": {"type": "boolean"},
    "needs_research": {"type": "boolean"},
    "needs_browser": {"type": "boolean"},
    "parallelizable": {"type": "boolean"},
    "working_directory": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "baseline_head": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "worktree_id": {"type": ["string", "null"]},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "validation_command": {"type": ["string", "null"], "minLength": 1, "maxLength": 500, "description": "Caller-declared, project-agnostic shell command (pytest, npm test, node --test, a custom script -- never hardcoded to one ecosystem) that a v2-repo-write execution's completion gate independently runs itself, in the isolated worktree, after commit -- never trusting a provider's self-report. null means no validation was requested for this Task; that Task's completion is never gated on tests_status."},
    "read_only": {"type": "boolean"},
    "preferred_provider": {"type": ["string", "null"]},
    "excluded_provider": {"type": ["string", "null"]},
    "execution_policies": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "recommended_provider": {"type": ["string", "null"]},
    "assigned_provider": {"type": ["string", "null"]},
    "account_id": {"type": ["string", "null"], "minLength": 1, "description": "Explicit provider account identity, used as a fallback when the launching Command does not set its own account_id; non-secret, resolved against the local account registry only -- never a config_dir/credential."},
    "mode": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "blocked_reason": {"type": ["string", "null"]},
    "source_context": {"type": "object"},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_version", "rules_digest", "mandatory_rule_ids", "mandatory_status_fields"],
      "properties": {
        "rules_version": {"type": "string", "minLength": 1},
        "rules_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mandatory_rule_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "mandatory_status_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "quota_evidence": {"type": ["object", "null"]},
    "current_progress": {"type": "string"},
    "next_action": {"type": "string"}
  }
}
