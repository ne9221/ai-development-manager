{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT Drive Dispatch Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "project_id", "title", "goal", "priority", "created_at"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "preferred_provider": {"type": ["string", "null"], "enum": ["codex", "claude", null]},
    "priority": {"type": "string", "enum": ["low", "normal", "high", "urgent"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
