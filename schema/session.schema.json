{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Session Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "provider", "project_id", "task_id", "conversation_label", "title", "summary", "started_at", "updated_at", "working_directory", "repository", "source_identifier", "classification_method", "classification_confidence", "classification_status", "status", "message_count", "model", "first_user_prompt"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1, "description": "Manager provider-aware key; legacy Codex records may retain the raw ID."},
    "provider": {"type": "string", "minLength": 1},
    "provider_session_id": {"type": ["string", "null"], "minLength": 1, "description": "Provider-owned raw session ID; null is accepted only for legacy compatibility."},
    "project_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "conversation_label": {"type": ["string", "null"], "maxLength": 500},
    "title": {"type": ["string", "null"], "maxLength": 500},
    "summary": {"type": ["string", "null"], "maxLength": 4000},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "working_directory": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "source_identifier": {"type": "string", "minLength": 1},
    "source_path": {"type": ["string", "null"]},
    "parent_session_id": {"type": ["string", "null"]},
    "usage_ref": {"type": ["string", "null"]},
    "resume_ref": {"type": ["string", "null"]},
    "mapping_source": {"type": ["string", "null"]},
    "content_hash": {"type": ["string", "null"]},
    "classification_method": {"enum": ["git_repository", "git_root", "git_repository_name", "working_directory", "project_alias", "session_repository_url", "explicit_project_header", "conflicting_deterministic_signals", "unclassified"]},
    "classification_confidence": {"enum": ["high", null]},
    "classification_status": {"enum": ["classified", "needs_review"]},
    "status": {"enum": ["active", "completed", "research", "obsolete", "unknown"]},
    "message_count": {"type": ["integer", "null"], "minimum": 0},
    "model": {"type": ["string", "null"]},
    "first_user_prompt": {"type": ["string", "null"], "maxLength": 1000}
  }
}
