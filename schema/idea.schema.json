{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Idea Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idea_id",
    "title",
    "description",
    "status",
    "priority",
    "project_id",
    "created_at",
    "source",
    "decision_note"
  ],
  "properties": {
    "idea_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "description": {"type": "string", "maxLength": 5000},
    "status": {"enum": ["pending", "confirmed", "converted", "dropped"]},
    "priority": {"enum": ["high", "medium", "low"]},
    "project_id": {"type": "string", "minLength": 1},
    "milestone_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "source": {"type": "string", "maxLength": 500},
    "decision_note": {"type": "string", "maxLength": 5000},
    "converted_at": {"type": ["string", "null"]},
    "dropped_at": {"type": ["string", "null"]},
    "drop_reason": {"type": ["string", "null"], "maxLength": 2000},
    "drop_problem": {"type": ["string", "null"], "maxLength": 2000}
  }
}
