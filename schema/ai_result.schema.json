            "native",
            "fenced",
            "deterministic",
            "heuristic",
            "none"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "warnings": {
          "type": "array",
