{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADM normalized AI result",
  "description": "ADM's canonical view of one agent result event. Every fact carries an evidence level bound to its source (see manager/nextplan/result.py). Generated from FIELD_KINDS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "event_id",
    "task_id",
    "role",
    "extraction",
    "facts",
    "evidence",
    "blockers",
    "warnings",
    "findings"
  ],
