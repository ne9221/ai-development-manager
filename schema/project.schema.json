{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Manager Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "name", "repo", "default_branch", "runtime_ssot", "project_rules", "active_tasks", "current_phase", "important_constraints"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "repo": {"type": "string", "format": "uri"},
    "default_branch": {"type": "string", "minLength": 1},
    "working_directory": {"type": ["string", "null"]},
    "baseline_commit": {"type": ["string", "null"]},
    "runtime_ssot": {"type": "string", "minLength": 1},
    "project_rules": {"type": "array", "items": {"type": "string"}},
    "active_tasks": {"type": "array", "items": {"type": "string"}},
    "current_phase": {"type": "string"},
    "important_constraints": {"type": "array", "items": {"type": "string"}},
    "execution_policies": {"type": "array", "items": {"type": "string"}}
  }
}
