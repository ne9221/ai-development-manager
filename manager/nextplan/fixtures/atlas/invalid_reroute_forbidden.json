        "retryable": true,
        "max_retry_policy": {
          "max_attempts": 2,
          "backoff_seconds": 0,
          "budget": "per_code"
        },
        "reroute_allowed": false,
        "human_gate_required": false,
        "terminal_if_unresolved": "HUMAN_GATE",
