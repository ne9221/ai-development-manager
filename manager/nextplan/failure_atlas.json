{
  "atlas_version": "1.0.0",
  "entries": [
    {"failure_code": "wrong_repo", "category": "repo_git", "severity": "critical",
     "description": "The execution worked in, or reported results for, a repository other than the task's declared repo.",
     "detection_signal": ["verify.repo.identity_mismatch", "result.repo_mismatch"],
     "required_evidence": ["task repo identity", "observed origin URL or reported repo"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "Hard stop for this execution (PROJECT-RULES ADM rule 12). Writes may have landed in another project; only a person can judge the blast radius."},
    {"failure_code": "wrong_worktree", "category": "repo_git", "severity": "high",
     "description": "The execution's working tree is not the worktree assigned to this task.",
     "detection_signal": ["verify.worktree.path_mismatch", "result.worktree_mismatch"],
     "required_evidence": ["assigned worktree path", "observed or reported worktree path"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "Another worktree may now be contaminated (one implementer per worktree)."},
    {"failure_code": "wrong_branch", "category": "repo_git", "severity": "high",
     "description": "Work was committed to, or reported on, a branch other than the task branch.",
     "detection_signal": ["verify.branch.mismatch", "result.branch_mismatch"],
     "required_evidence": ["task branch", "observed or reported branch"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "The other branch may be protected or owned by someone else; moving commits is a destructive decision."},
    {"failure_code": "dirty_worktree", "category": "repo_git", "severity": "medium",
     "description": "The task's own worktree has uncommitted in-scope changes after the agent said it finished.",
     "detection_signal": ["verify.git_status.dirty_in_scope", "result.git_status_dirty"],
     "required_evidence": ["git status --porcelain of the task worktree", "allowed_paths"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "WORKING",
     "notes": "The worker commits or explains the leftover changes; nobody else cleans them."},
    {"failure_code": "unrelated_dirty_files", "category": "repo_git", "severity": "high",
     "description": "The worktree has dirty paths outside the task's scope, or pre-existing dirty files this task does not own.",
     "detection_signal": ["verify.git_status.dirty_out_of_scope"],
     "required_evidence": ["git status --porcelain", "allowed_paths", "baseline dirty set if known"],
     "safe_default": "MARK_BLOCKED", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "BLOCKED",
     "notes": "Never stage, clean or revert files this task does not own (AI-DEVELOPMENT-RULES 18). Resume only in a freshly materialized worktree."},
    {"failure_code": "stale_base", "category": "repo_git", "severity": "medium",
     "description": "The candidate is built on a base older than the base the task requires.",
     "detection_signal": ["verify.base.behind_required_base"],
     "required_evidence": ["task baseline_head", "candidate merge-base"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "The worker rebases once; a second stale result means the base is moving and a person should pick the base."},
    {"failure_code": "merge_conflict", "category": "repo_git", "severity": "high",
     "description": "Integrating the candidate with its base produced conflicts.",
     "detection_signal": ["result.merge_conflict", "verify.git.unmerged_paths"],
     "required_evidence": ["conflicting paths"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "Conflict resolution chooses whose change wins; that is an ambiguous, potentially destructive decision."},
    {"failure_code": "push_failed", "category": "repo_git", "severity": "medium",
     "description": "The push of the task branch failed, or local HEAD is ahead of the remote branch.",
     "detection_signal": ["result.push_failed", "verify.push.local_ahead_of_remote"],
     "required_evidence": ["local HEAD", "remote branch SHA or push error"],
     "safe_default": "RETRY_SAME_AGENT", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 60, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "UNCHANGED",
     "notes": "Never COMPLETE on an unpushed candidate. Never force-push."},
    {"failure_code": "remote_advanced", "category": "repo_git", "severity": "high",
     "description": "The remote task branch has commits the candidate does not contain.",
     "detection_signal": ["verify.remote.not_ancestor_of_head"],
     "required_evidence": ["remote branch SHA", "candidate HEAD", "ancestry check"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "Someone else wrote the branch. Force-pushing would destroy their work."},
    {"failure_code": "missing_remote", "category": "repo_git", "severity": "medium",
     "description": "A push was claimed but the remote branch does not exist.",
     "detection_signal": ["verify.remote.branch_absent"],
     "required_evidence": ["git ls-remote result for the task branch"],
     "safe_default": "RETRY_SAME_AGENT", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 60, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "UNCHANGED",
     "notes": "Commit is not push: prove the ref on the remote before anyone reviews it."},
    {"failure_code": "detached_head", "category": "repo_git", "severity": "medium",
     "description": "The worktree HEAD is detached, so new commits are on no branch.",
     "detection_signal": ["verify.head.detached", "result.detached_head"],
     "required_evidence": ["git symbolic-ref HEAD result"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "The worker attaches its commits to the task branch without discarding any."},
    {"failure_code": "scope_violation", "category": "repo_git", "severity": "critical",
     "description": "The diff touches paths outside the task's allowed_paths.",
     "detection_signal": ["verify.diff.out_of_allowed_paths"],
     "required_evidence": ["git diff --name-only baseline..HEAD", "allowed_paths"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "Mirrors manager.repo_write_enforcement.enforce_allowed_paths, which already refuses such a completion on the repo-write path."},

    {"failure_code": "agent_timeout", "category": "agent_execution", "severity": "medium",
     "description": "The agent did not finish within its hard timeout.",
     "detection_signal": ["execution.timed_out"],
     "required_evidence": ["execution hard_timeout_at", "terminal record"],
     "safe_default": "RETRY_SAME_AGENT", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "UNCHANGED",
     "notes": "One retry; a second timeout suggests the slice is too large (AI-DEVELOPMENT-RULES 14)."},
    {"failure_code": "agent_crash", "category": "agent_execution", "severity": "medium",
     "description": "The agent process exited abnormally without a result.",
     "detection_signal": ["execution.crashed", "execution.nonzero_exit_without_result", "result.status_error"],
     "required_evidence": ["exit code", "absence of a result event"],
     "safe_default": "RETRY_SAME_AGENT", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 30, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "UNCHANGED",
     "notes": "Matches executions.MAX_RETRY_COUNT = 2."},
    {"failure_code": "agent_lost", "category": "agent_execution", "severity": "high",
     "description": "The agent stopped being observable and no terminal record exists.",
     "detection_signal": ["execution.lost_no_terminal"],
     "required_evidence": ["last heartbeat", "process liveness probe"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "It may still be writing, or may have written partially. Retrying could create a second writer."},
    {"failure_code": "session_not_resumable", "category": "agent_execution", "severity": "medium",
     "description": "Continuing the original session was required but the provider refused to resume it.",
     "detection_signal": ["execution.resume_rejected"],
     "required_evidence": ["resume attempt result"],
     "safe_default": "REROUTE_AGENT", "fallback_action": "HUMAN_GATE", "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "UNCHANGED",
     "notes": "A new session of the same role receives the full handoff; the lost context is recorded."},
    {"failure_code": "quota_exhausted", "category": "agent_execution", "severity": "medium",
     "description": "The provider account has no remaining quota for this work.",
     "detection_signal": ["execution.quota_exhausted", "result.quota_exhausted"],
     "required_evidence": ["provider error or verified quota source"],
     "safe_default": "REROUTE_AGENT", "fallback_action": "WAIT_DEPENDENCY", "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "UNCHANGED",
     "notes": "Reroute when another eligible agent exists, otherwise wait for the reset. Never guess the reset time (AI-DEVELOPMENT-RULES 11)."},
    {"failure_code": "rate_limited", "category": "agent_execution", "severity": "low",
     "description": "The provider throttled the request; quota itself is not exhausted.",
     "detection_signal": ["execution.rate_limited", "result.rate_limited"],
     "required_evidence": ["provider 429/rate-limit error"],
     "safe_default": "RETRY_SAME_AGENT", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 3, "backoff_seconds": 300, "budget": "per_code"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "UNCHANGED",
     "notes": "Backoff is a floor, not a promise of recovery."},
    {"failure_code": "malformed_result", "category": "agent_execution", "severity": "medium",
     "description": "No usable result could be extracted from the agent output.",
     "detection_signal": ["extract.no_parseable_payload", "extract.payload_invalid_json"],
     "required_evidence": ["raw output digest", "extraction attempts"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {"reviewer": "SEND_TO_REVIEW"},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "Extraction yields UNKNOWN, never PASS. The worker is asked once for a structured report; a malformed review is re-run by a fresh reviewer."},
    {"failure_code": "incomplete_result", "category": "agent_execution", "severity": "medium",
     "description": "The result is parseable but required fields are missing or the output was truncated.",
     "detection_signal": ["extract.payload_truncated", "result.required_field_missing"],
     "required_evidence": ["missing field list"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {"reviewer": "SEND_TO_REVIEW"},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": ""},
    {"failure_code": "contradictory_result", "category": "agent_execution", "severity": "high",
     "description": "The result contradicts itself (e.g. status PASS with failing test counts, or two different verdicts).",
     "detection_signal": ["result.status_contradicts_counts", "extract.conflicting_statements"],
     "required_evidence": ["the contradicting fields or statements"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {"reviewer": "SEND_TO_REVIEW"},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "A contradiction is never resolved in favour of the more optimistic statement."},
    {"failure_code": "false_pass", "category": "agent_execution", "severity": "critical",
     "description": "The agent claimed success and an independent probe proved the claim false.",
     "detection_signal": ["verify.claim_contradicted"],
     "required_evidence": ["the claim", "the probe result that contradicts it"],
     "safe_default": "RETURN_TO_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "REPAIRING",
     "notes": "The original worker gets the probe evidence once. A repeat means the agent's reports cannot be trusted for this task."},
    {"failure_code": "hallucinated_test_result", "category": "agent_execution", "severity": "critical",
     "description": "Reported tests or counts do not exist in, or disagree with, the test evidence.",
     "detection_signal": ["verify.tests.reported_not_in_evidence", "verify.tests.count_mismatch"],
     "required_evidence": ["reported test summary", "ADM-run or artifact test evidence"],
     "safe_default": "RETURN_TO_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "REPAIRING",
     "notes": ""},
    {"failure_code": "agent_reported_blocked", "category": "agent_execution", "severity": "medium",
     "description": "The agent stopped and reported a blocker it cannot resolve itself.",
     "detection_signal": ["result.status_blocked"],
     "required_evidence": ["reported blocker text"],
     "safe_default": "HUMAN_GATE", "fallback_action": null, "role_overrides": {},
     "retryable": false, "max_retry_policy": {"max_attempts": 0, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": true, "terminal_if_unresolved": "MARK_BLOCKED", "next_state": "HUMAN_GATE",
     "notes": "The blocker is a REPORTED claim; a person decides whether it is real."},
    {"failure_code": "agent_reported_fail", "category": "agent_execution", "severity": "medium",
     "description": "The agent explicitly reported FAIL without a more specific failure being identified.",
     "detection_signal": ["result.status_fail"],
     "required_evidence": ["reported status FAIL"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "A more specific failure (tests, push, quota...) always outranks this one when both are present."},

    {"failure_code": "test_failed", "category": "test_review", "severity": "medium",
     "description": "Required tests ran and failed.",
     "detection_signal": ["verify.tests.failed", "result.tests_failed_nonzero"],
     "required_evidence": ["test command", "exit code or failing test ids"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {"reviewer": "RETURN_TO_WORKER"},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "Known-baseline failures are not this task's defect only when a base run at the same base_sha proves it (see regression_unknown)."},
    {"failure_code": "test_not_run", "category": "test_review", "severity": "medium",
     "description": "The task requires tests and none were run.",
     "detection_signal": ["result.tests_run_zero", "verify.tests.no_evidence_required"],
     "required_evidence": ["task test requirement", "tests_run count or absence of evidence"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": ""},
    {"failure_code": "partial_test_run", "category": "test_review", "severity": "medium",
     "description": "Only a subset of the required tests ran (skips, selection, or interruption).",
     "detection_signal": ["result.tests_partial", "verify.tests.subset_of_required"],
     "required_evidence": ["required test set", "executed test set"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": ""},
    {"failure_code": "reviewer_fail", "category": "test_review", "severity": "medium",
     "description": "An admissible, fresh reviewer returned FAIL on the candidate.",
     "detection_signal": ["result.review_verdict_fail"],
     "required_evidence": ["review verdict", "findings", "reviewed SHA"],
     "safe_default": "RETURN_TO_WORKER", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 0, "budget": "repair"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "REPAIRING",
     "notes": "Findings go back to the ORIGINAL worker session; the reviewer never becomes the implementer (AI-DEVELOPMENT-RULES 32)."},
    {"failure_code": "reviewer_crash", "category": "test_review", "severity": "medium",
     "description": "The reviewer process ended without a verdict.",
     "detection_signal": ["execution.reviewer_crashed"],
     "required_evidence": ["reviewer terminal record"],
     "safe_default": "SEND_TO_REVIEW", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 2, "backoff_seconds": 30, "budget": "review"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "AWAITING_REVIEW",
     "notes": "A new fresh reviewer, not a resume of the crashed one."},
    {"failure_code": "reviewer_not_fresh", "category": "test_review", "severity": "high",
     "description": "The reviewer shares a session or context with the implementer, or reused an earlier review session.",
     "detection_signal": ["review.session_reused", "review.reviewer_is_implementer"],
     "required_evidence": ["reviewer session id", "worker and prior reviewer session ids"],
     "safe_default": "SEND_TO_REVIEW", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "review"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "AWAITING_REVIEW",
     "notes": "Its verdict is inadmissible whether it says PASS or FAIL."},
    {"failure_code": "review_target_mismatch", "category": "test_review", "severity": "high",
     "description": "The reviewer reviewed a SHA other than the current candidate.",
     "detection_signal": ["review.reviewed_sha_not_candidate"],
     "required_evidence": ["reviewed SHA", "candidate head SHA"],
     "safe_default": "SEND_TO_REVIEW", "fallback_action": null, "role_overrides": {},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "review"},
     "reroute_allowed": true, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "AWAITING_REVIEW",
     "notes": "A stale review never approves a newer candidate."},
    {"failure_code": "evidence_missing", "category": "test_review", "severity": "low",
     "description": "A success claim has no evidence that could verify it.",
     "detection_signal": ["verify.claim_unverifiable", "review.pass_without_evidence"],
     "required_evidence": ["the unevidenced claim"],
     "safe_default": "CONTINUE_WORKER", "fallback_action": null, "role_overrides": {"reviewer": "SEND_TO_REVIEW"},
     "retryable": true, "max_retry_policy": {"max_attempts": 1, "backoff_seconds": 0, "budget": "per_code"},
     "reroute_allowed": false, "human_gate_required": false, "terminal_if_unresolved": "HUMAN_GATE", "next_state": "WORKING",
     "notes": "No evidence means UNKNOWN, and UNKNOWN never completes a task. Severity is deliberately the lowest: this is the generic gap, so any specific failure that explains why the evidence is missing (drive_unavailable, test_not_run, missing_remote...) outranks it and decides the action."},
    {"failure_code": "regression_unknown", "category": "test_review", "severity": "medium",
     "description": "Tests fail and there is no sound base-SHA evidence to say whether the failure is new.",
     "detection_signal": ["verify.tests.failed_base_unknown"],
     "required_evidence": ["failing test ids", "absence of base attestation"],
